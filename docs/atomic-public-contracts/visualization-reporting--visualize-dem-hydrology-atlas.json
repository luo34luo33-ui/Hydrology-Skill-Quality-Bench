  "interface": {
    "schema_version": "1.0",
    "inputs": [
      {
        "id": "prepare_result",
        "description": "prepare-dem-analysis-grid 生成且 artifacts 哈希可验证的 result.json。",
        "required": true,
        "format": "JSON"
      },
      {
        "id": "extract_result",
        "description": "extract-dem-stream-network 生成的可选 result.json；缺失时仅生成两张 DEM 图。",
        "required": false,
        "format": "JSON"
      }
    ],
    "outputs": [
      {
        "id": "atlas_figures",
        "description": "每个固定模板对应的 PNG、SVG 和 figure.json。",
        "required": true,
        "format": "PNG, SVG and JSON"
      },
      {
        "id": "run_result",
        "description": "符合 visualization-run-result schema 的总运行结果。",
        "required": true,
        "format": "JSON"
      }
    ],
    "invariants": [
      "v2 PNG 最长边为 2400 像素，另一边跟随流域长宽比；figure.json 记录实际尺寸，SVG 与 PNG 使用相同布局。",
      "白色背景，图内无主副标题或外置侧栏；原主标题保留为图件元数据中的图名。",
      "中文宋体 SimSun，英文、数字和单位 Times New Roman；图例与放大的 colorbar 均位于主图内部。",
      "主图包含真实投影的 WGS84 经纬网，底边经度、左边纬度；刻度来自经纬线与图框交点。",
      "所有地图数据仅在显示时裁切到真实流域边界，保留孔洞和多部件；流域外像元不参与色标显示范围。",
      "所有使用的输入 artifact 必须先通过 SHA-256、CRS 和网格检查。",
      "显示变换不得修改或覆盖任何上游空间数据。",
      "中文和英文只改变文字，不改变图层、色带或数据表达。"
    ]
  },
