      "inputs": [
        {
          "id": "event_series",
          "description": "按场次提供的观测与模拟序列表；单文件多 sheet 或多文件目录均可。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "observed",
              "semantics": "场次观测流量序列，列名由 --observed-column 给出。",
              "units": "m3/s as confirmed",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；不得填 0 后计算指标。"
            },
            {
              "name": "simulated",
              "semantics": "场次模拟流量序列，列名由 --simulated-column 给出，单位必须与观测一致。",
              "units": "m3/s as confirmed",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；不得填 0 后计算指标。"
            },
            {
              "name": "time",
              "semantics": "场次时间索引，用于峰现时间误差。",
              "units": "datetime",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "空值或重复值必须停止。"
            }
          ]
        },
        {
          "id": "pass_thresholds",
          "description": "合格判定阈值，必须由使用者显式给出，缺失时不判定合格。",
          "required": false,
          "format": "CLI argument or JSON"
        }
      ],
      "outputs": [
        {
          "id": "event_metrics",
          "description": "逐场次指标表，一场一行。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "volume_error_relative",
              "semantics": "洪量相对误差，定义为 (观测洪量 - 模拟洪量) / 观测洪量。",
              "units": "dimensionless",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "观测洪量为 0 时记为 unavailable。"
            },
            {
              "name": "peak_time_error_hours",
              "semantics": "峰现时间误差，定义为模拟峰时刻减观测峰时刻，正值为模拟峰现偏晚。",
              "units": "h",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "并列峰时取首个最大值，并给出 warning。"
            },
            {
              "name": "nse",
              "semantics": "标准纳什效率系数；观测方差为 0 时记为 unavailable。",
              "units": "dimensionless",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "不适用时记为 unavailable，不写 NaN。"
            },
            {
              "name": "r2",
              "semantics": "决定系数，采用 scikit-learn 约定；观测为常数序列时给出边界值而非 unavailable。",
              "units": "dimensionless",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "不适用时记为 unavailable，不写 NaN。"
            }
          ]
        },
        {
          "id": "run_result",
          "description": "符合 HydroTune 运行结果约定的 result.json，含参数、输入与产物 SHA-256、QC 与 provenance。",
          "required": true,
          "format": "JSON"
        }
      ],
      "simulation_period": {
        "required": true,
        "semantics": "每个场次覆盖的全部时步；任一场次的时间轴、缺测或长度检查失败即退出码 2。"
      },
      "invariants": [
        "时间轴必须严格递增、等间隔，并与 --timestep-hours 一致。",
        "观测与模拟长度必须一致，且不得含缺测或非有限值。",
        "洪量换算必须使用显式 dt 与显式单位，不得使用写死的换算系数。",
        "合格判定阈值必须显式给出；缺失时合格列记为 unavailable，不套用默认阈值。",
        "输出只写入 --output-dir；不修改输入，也不静默复用旧结果。"
      ]
