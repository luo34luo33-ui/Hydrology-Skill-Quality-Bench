        {
          "id": "metrics_table",
          "description": "逐场次指标表，通常由 compute-event-flood-metrics 产出，一场一行。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "value_column",
              "semantics": "待聚合的数值指标列，由 --value-columns 显式列出。",
              "units": "沿用上游指标单位",
              "time_step": "not applicable",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
