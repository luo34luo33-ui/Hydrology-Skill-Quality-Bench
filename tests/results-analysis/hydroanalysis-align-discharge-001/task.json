  "id": "hydroanalysis-align-discharge-001",
  "primary_skill": "post-processing/align-observed-simulated-discharge",
  "prompt": "Use observed_result.json and simulation_result.json exactly as supplied to run post-processing/align-observed-simulated-discharge. The observed artifact is a prepare-discharge-timeseries result and the simulation artifact is a lumped HBV result; both are hash-checked by the skill. Write the native outputs (aligned_discharge.csv, evaluation_discharge.csv, excluded_observations.csv, alignment_qc.json, result.json) under align-out/. Do not modify the upstream artifacts or relax the hash checks.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "align-out/aligned_discharge.csv",
    "align-out/evaluation_discharge.csv",
    "align-out/excluded_observations.csv",
    "align-out/alignment_qc.json",
    "align-out/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The upstream results are consumed by their native adapters and hash checks; they must not be altered.",
    "Timestamps carry explicit +08:00 offsets on a complete hourly axis.",
    "Do not install software or implement a replacement alignment."
  ],
  "timeout_seconds": 300,
  "title": "Align observed discharge with an HBV outlet simulation"
}
