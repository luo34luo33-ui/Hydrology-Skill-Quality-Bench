    "interface": {
      "schema_version": "1.0",
      "inputs": [
        {
          "id": "series",
          "description": "一条连续的观测—模拟序列表。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "observed",
              "semantics": "连续观测流量序列，列名由 --observed-column 给出。",
              "units": "m3/s as confirmed",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；不得填 0 后计算指标。"
            },
            {
              "name": "simulated",
              "semantics": "连续模拟流量序列，列名由 --simulated-column 给出，单位必须与观测一致。",
              "units": "m3/s as confirmed",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；不得填 0 后计算指标。"
            },
            {
              "name": "time",
              "semantics": "连续时间索引，严格递增且等间隔。",
              "units": "datetime",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "空值或重复值必须停止。"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "series_metrics",
          "description": "长表形式的指标结果，每行一项指标。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "nse",
              "semantics": "标准纳什效率系数；观测方差为 0 时记为 unavailable。",
              "units": "dimensionless",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "不适用时记为 unavailable，不写 NaN。"
            },
            {
              "name": "volume_bias",
              "semantics": "水量偏差，定义为 sum(模拟 - 观测) 乘以显式时间步长，单位 m3。",
              "units": "m3",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "accumulated",
              "missing_value_semantics": "不适用时记为 unavailable，不写 NaN。"
            },
            {
              "name": "relative_volume_bias",
              "semantics": "水量偏差除以观测总水量；观测总水量为 0 时记为 unavailable。",
              "units": "dimensionless",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "不适用时记为 unavailable，不写 NaN。"
            }
          ]
        },
        {
          "id": "run_result",
          "description": "符合 HydroTune 运行结果约定的 result.json，含参数、输入与产物 SHA-256、QC 与 provenance。",
          "required": true,
          "format": "JSON"
        }
      ],
      "simulation_period": {
        "required": true,
        "semantics": "输入序列覆盖的全部时步；时间轴、缺测或长度检查失败即退出码 2。"
      },
      "invariants": [
        "时间轴必须严格递增、等间隔，并与 --timestep-hours 一致。",
        "观测与模拟长度必须一致，且不得含缺测或非有限值。",
        "水量偏差必须使用显式 dt 换算，不得使用写死的换算系数。",
        "指标不可计算时必须记为 unavailable，不得输出 NaN 或占位数值。",
        "输出只写入 --output-dir；不修改输入，也不静默复用旧结果。"
      ]
    },
