        "eto-out/eto.csv": [
          "time",
          "source_id",
          "ETo_mm"
        ],
        "eto-out/mapped_evap.csv": [
          "time",
          "source_id",
          "variable",
          "depth_mm"
        ],
        "eto-out/result.json": [
          "schema_version",
          "skill",
          "status",
          "message",
          "parameters",
          "inputs",
          "artifacts",
          "checks",
          "warnings",
          "provenance"
