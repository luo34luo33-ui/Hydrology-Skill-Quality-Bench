  "id": "hydrodata-eto-faopm-001",
  "primary_skill": "data-processing/derive-potential-evapotranspiration",
  "prompt": "Use met.csv, stations.csv, and config.json exactly as supplied to run data-processing/derive-potential-evapotranspiration. The meteorology table is daily for two stations in July 2020; all columns, units, timezone, and the PET mapping (factor 1.0, negative_policy floor_zero) are confirmed in the config. Write the native outputs (eto.csv, mapped_evap.csv, result.json) under eto-out/. Do not alter the config, fill missing values, or substitute another evapotranspiration formula.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "eto-out/eto.csv",
    "eto-out/mapped_evap.csv",
    "eto-out/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The config (columns, canonical units, timezone, mapping policy) is confirmed by the user and must not be altered.",
    "Meteorology values are instantaneous daily aggregates; ETo follows FAO-56 Penman-Monteith.",
    "Do not install software or implement a replacement formula."
  ],
  "timeout_seconds": 300,
  "title": "Derive FAO-56 daily ETo for two stations and map it to PET"
}
