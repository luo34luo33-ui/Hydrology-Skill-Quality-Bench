      "weight": 0.05
    },
    {
      "field": "message",
      "name": "result_message",
      "reference": "expected/golden_workspace/eto-out/result.json",
      "target": "eto-out/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "warnings",
