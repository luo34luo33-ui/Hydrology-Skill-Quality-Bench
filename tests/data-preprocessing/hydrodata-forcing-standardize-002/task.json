  "id": "hydrodata-forcing-standardize-002",
  "primary_skill": "data-processing/prepare-model-forcing-timeseries",
  "prompt": "Use gauge.csv and config.json exactly as supplied to run data-processing/prepare-model-forcing-timeseries. The source is a running cumulative gauge (running_cumulative in mm/step) with an explicit reset_flag column; the confirmed resets at steps 12, 24, and 36 restart the counter, and the skill converts it into interval-end step depths. Write the native outputs (prepared_forcing.csv, series_metadata.json, result.json) under forcing-out/. Do not relabel the semantics, diff the series yourself, or alter the reset flags.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "forcing-out/prepared_forcing.csv",
    "forcing-out/series_metadata.json",
    "forcing-out/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The config (variable, semantics, unit, column mapping, timezone) is confirmed by the user and must not be altered.",
    "Depths are interval-end mm/step values on a complete hourly axis.",
    "Do not install software or implement a replacement conversion."
  ],
  "timeout_seconds": 300,
  "title": "Convert a running cumulative gauge with explicit resets into step depths"
