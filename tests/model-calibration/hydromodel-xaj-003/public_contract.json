{
  "version": "atomic-three-arm-v2",
  "task_id": "hydromodel-xaj-003",
  "capability": {
    "version": "atomic-three-arm-v2",
    "interface_id": "hydrological-modeling/run-lumped-xaj-model",
    "source_contract_sha256": "d49fee20d36a7d3ee5c57c992a8699c8c96d6a59d8a56be41596fc97ddac3067",
    "interface": {
      "schema_version": "1.0",
      "inputs": [
        {
          "id": "forcing_table",
          "description": "包含时间、面平均降雨和蒸发能力的 forcing 表；event 模式下可由一个目录或一个多 sheet 工作簿提供多场次。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "P",
              "semantics": "面平均降雨强度，由调用方确认为面平均值而非单站值。",
              "units": "mm/h",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；不得静默填 0 或插值后继续。"
            },
            {
              "name": "E0",
              "semantics": "蒸发能力，由调用方提供；本 Skill 不内置月份蒸发查表。",
              "units": "mm/h",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；来源与处理方法由调用方记录。"
            },
            {
              "name": "time",
              "semantics": "严格递增且等间隔的时间索引。",
              "units": "datetime",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "空值或重复值必须停止。"
            }
          ]
        },
        {
          "id": "parameter_set",
          "description": "集总式新安江参数集，包含产流、蒸发、三水源与调蓄参数及状态初值。",
          "required": true,
          "format": "JSON or YAML",
          "variables": [
            {
              "name": "WM",
              "semantics": "流域平均蓄水容量，WM 必须不小于 WUM 与 WLM 之和。",
              "units": "mm",
              "state_or_flux": "state",
              "accumulated_or_instantaneous": "not_applicable",
              "catchment_area": "由 --area-km2 显式提供，单位 km2",
              "missing_value_semantics": "缺失必须停止，不得使用经验默认值。"
            },
            {
              "name": "IM",
              "semantics": "不透水面积比例，取值落在 0 到 1 之间。",
              "units": "fraction",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "缺失必须停止，不得使用经验默认值。"
            }
          ]
        },
        {
          "id": "catchment_area",
          "description": "流域面积，由 --area-km2 显式提供，用于 mm 到 m3/s 的转换系数 U = Area / (3.6 * T)。",
          "required": true,
          "format": "CLI argument"
        }
      ],
      "outputs": [
        {
          "id": "simulation_table",
          "description": "逐时步状态与通量表，包含 Qt 及全部中间状态列；event 模式带场次标识列。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "Qt",
              "semantics": "坡面与河网调蓄后的河网入口流量，尚未经过串联河道演算。",
              "units": "m3/s",
              "time_step": "与输入时间步长一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "计算失败时不产出；不写 NaN。"
            },
            {
              "name": "W",
              "semantics": "三层土壤含水量之和，必须不超过 WM。",
              "units": "mm",
              "time_step": "与输入时间步长一致",
              "state_or_flux": "state",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "计算失败时不产出；不写 NaN。"
            }
          ]
        },
        {
          "id": "event_index",
          "description": "event 模式下的场次清单，记录每场的行数、起止时间与预热步数。",
          "required": false,
          "format": "CSV"
        },
        {
          "id": "run_result",
          "description": "符合 HydroTune 运行结果约定的 result.json，含参数、输入与产物 SHA-256、QC 与 provenance。",
          "required": true,
          "format": "JSON"
        }
      ],
      "warmup_period": {
        "required": false,
        "semantics": "由 --warmup-steps 显式声明的前 N 步预热；预热段标记 is_warmup 且不纳入模拟期统计，预热长度不足时退出码 2。"
      },
      "simulation_period": {
        "required": true,
        "semantics": "扣除预热后的全部时步；模拟期为空即视为失败，退出码 2。"
      },
      "invariants": [
        "时间轴必须严格递增、等间隔，并与 --timestep-hours 一致。",
        "分层土壤含水量必须满足 0 <= WU <= WUM、0 <= WL <= WLM、0 <= WD <= WM - WUM - WLM，且 W <= WM。",
        "可渗透区水量平衡 sum(P_perv) - sum(E) - sum(R) 必须等于模拟期土壤蓄量变化，残差相对可渗透区降雨总量的比例不得超过 --balance-tolerance-fraction（默认 0.1%）。",
        "状态与通量必须全部有限，出现 NaN 或 Inf 即失败。",
        "输出只写入 --output-dir，forcing 缺测或参数越界即停止，不静默填充也不静默复用旧结果。"
      ]
    },
