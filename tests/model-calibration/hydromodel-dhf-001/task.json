{
  "data_description": "A deterministic continuous lumped-model problem with a complete confirmed parameter set and an hourly forcing table.",
  "data_files": [
    "forcing.csv",
    "parameters.json"
  ],
  "difficulty": "intermediate",
  "domain": "model-calibration",
  "grading": [
    {
      "name": "artifact_schema",
      "required_columns": {
        "dhf-run/lumped_dhf_runoff.csv": [
          "time",
          "is_warmup",
          "P",
          "PET",
          "E",
          "PE",
          "PC",
          "Y0",
          "EU",
          "EL",
          "RR",
          "Y",
          "YU",
          "YL",
          "RUNOFF",
          "QS",
          "QL",
          "Q",
          "SA",
          "UA",
          "YA",
          "EB"
        ],
        "dhf-run/result.json": [
          "schema_version",
          "skill",
          "status",
          "message",
          "parameters",
          "inputs",
          "artifacts",
          "checks",
          "warnings",
          "provenance"
        ]
      },
      "targets": [
        "dhf-run/lumped_dhf_runoff.csv",
        "dhf-run/result.json"
      ],
      "type": "file_check",
      "weight": 0.1
    },
    {
      "atol": 1e-09,
      "datetime_columns": [
        "time"
      ],
      "name": "simulation_table",
      "reference": "expected/golden_workspace/dhf-run/lumped_dhf_runoff.csv",
      "rtol": 1e-09,
      "target": "dhf-run/lumped_dhf_runoff.csv",
      "type": "table_match",
      "weight": 0.3
    },
    {
      "field": "skill",
      "name": "result_skill",
      "reference": "expected/golden_workspace/dhf-run/result.json",
      "target": "dhf-run/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "status",
      "name": "result_status",
      "reference": "expected/golden_workspace/dhf-run/result.json",
      "target": "dhf-run/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "message",
      "name": "result_message",
      "reference": "expected/golden_workspace/dhf-run/result.json",
      "target": "dhf-run/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "warnings",
      "name": "result_warnings",
      "reference": "expected/golden_workspace/dhf-run/result.json",
      "target": "dhf-run/result.json",
      "type": "exact_match",
      "weight": 0.1
    },
    {
      "field": "checks",
      "name": "result_checks",
      "reference": "expected/golden_workspace/dhf-run/result.json",
      "target": "dhf-run/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "name": "artifact_references",
      "required_keys": [
        "simulation_table"
      ],
      "target": "dhf-run/result.json",
      "type": "artifact_reference_check",
      "weight": 0.3
    }
  ],
  "id": "hydromodel-dhf-001",
  "primary_skill": "hydrological-modeling/run-lumped-dhf-model",
  "prompt": "Use forcing.csv and parameters.json exactly as supplied to run hydrological-modeling/run-lumped-dhf-model. The forcing table is hourly; P and the potential evaporation column (pass --pet-column E0) are instantaneous rates in mm/h on a gap-free axis. The 18-parameter set is confirmed; area is 640 km2, river length is 20 km, timestep is 1 h, mode is continuous, warm-up is 12 steps, and the user confirms a water-balance tolerance of 0.05 to account for the unit-hydrograph end truncation. Write the native outputs (lumped_dhf_runoff.csv, result.json) under dhf-run/. Do not modify parameters, fill missing values, change the warm-up, or substitute another model implementation.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "dhf-run/lumped_dhf_runoff.csv",
    "dhf-run/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The parameter set, area, timestep, mode, and warm-up are confirmed by the user and must not be altered.",
    "P and the evaporation column are instantaneous rates in mm/h; discharge outputs are in m3/s.",
    "Do not install software or implement a replacement model."
  ],
  "timeout_seconds": 300,
  "title": "Run a continuous lumped DHF simulation with two-segment warm-up"
}
