  "id": "hydromodel-gr4j-001",
  "primary_skill": "hydrological-modeling/run-lumped-gr4j-model",
  "prompt": "Use forcing.csv and parameters.json exactly as supplied to run hydrological-modeling/run-lumped-gr4j-model. The forcing table is daily; P and the potential evaporation column (pass --pet-column E0) are depths in mm per day on a gap-free axis. The 4-parameter set is confirmed; area is 640 km2, timestep is 24 h, mode is continuous, warm-up is 12 steps, and the user confirms a water-balance tolerance of 0.2 for the approximate groundwater-exchange closure. Write the native outputs (lumped_gr4j_runoff.csv, result.json) under gr4j-run/. Do not modify parameters, fill missing values, change the warm-up, or substitute another model implementation.",
  "required_outputs": [
    "gr4j-run/lumped_gr4j_runoff.csv",
    "gr4j-run/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The parameter set, area, timestep, mode, and warm-up are confirmed by the user and must not be altered.",
    "P and the evaporation column are instantaneous rates in mm/h; discharge outputs are in m3/s.",
    "Do not install software or implement a replacement model."
  ],
  "timeout_seconds": 300,
  "title": "Run a continuous daily lumped GR4J simulation"
}
