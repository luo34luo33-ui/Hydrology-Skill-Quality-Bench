{
  "version": "atomic-three-arm-v2",
  "task_id": "hydromodel-tank-003",
  "capability": {
    "version": "atomic-three-arm-v2",
    "interface_id": "hydrological-modeling/run-lumped-tank-model",
    "source_contract_sha256": "2ae85072b134176b1fa3717bfa70888f42ff18b8362381f8bf82f55f1f2417f8",
    "interface": {
      "schema_version": "1.0",
      "inputs": [
        {
          "id": "forcing_table",
          "description": "包含时间、面平均降雨与蒸发能力的 forcing 表；event 模式下可由一个目录或一个多 sheet 工作簿提供多场次。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "P",
              "semantics": "面平均降雨，每步长水深；由调用方确认为面平均值。",
              "units": "mm per time step",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；不得静默填 0 或插值后继续。"
            },
            {
              "name": "evap",
              "semantics": "蒸发能力，每步长水深，直接从降雨扣除得到净雨，不从土壤调蓄。",
              "units": "mm per time step",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "缺测必须停止；来源与处理方法由调用方记录。"
            },
            {
              "name": "time",
              "semantics": "严格递增且等间隔的时间索引。",
              "units": "datetime",
              "time_step": "由 --timestep-hours 显式声明并与时间列推断值一致",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "空值或重复值必须停止。"
            }
          ]
        },
        {
          "id": "parameter_set",
          "description": "Tank 16 参数集，全部必填，无静默默认；四箱初始蓄水 t0_is..t3_is 亦为参数。",
          "required": true,
          "format": "JSON or YAML",
          "variables": [
            {
              "name": "t0_soh_uo",
              "semantics": "顶箱上侧孔高度，必须不小于下侧孔高度 t0_soh_lo。",
              "units": "mm",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "缺失必须停止，不得使用经验默认值。"
            },
            {
              "name": "t3_soc",
              "semantics": "末箱侧孔出流系数，取值落在 0 到 1 之间。",
              "units": "fraction",
              "state_or_flux": "not_applicable",
              "accumulated_or_instantaneous": "not_applicable",
              "missing_value_semantics": "缺失必须停止，不得使用经验默认值。"
            }
          ]
        },
        {
          "id": "basin_properties",
          "description": "流域属性，由 CLI 显式提供：--area-km2（流域面积）、--timestep-hours（时间步长）。",
          "required": true,
          "format": "CLI arguments"
        }
      ],
      "outputs": [
        {
          "id": "simulation_table",
          "description": "逐时步状态与通量表，含出口流量 Q、四箱蓄水与各孔出流列；event 模式带场次标识列。",
          "required": true,
          "format": "CSV, Parquet or XLSX",
          "variables": [
            {
              "name": "Q",
              "semantics": "流域出口流量，全部侧孔出流之和按面积换算，负值已截断为 0。",
              "units": "m3/s",
              "time_step": "与输入时间步长一致",
              "state_or_flux": "flux",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "QC 失败时不产出；不写 NaN。"
            },
            {
              "name": "S0",
              "semantics": "顶箱蓄水状态，非负；顶箱入流为净雨 P - evap。",
              "units": "mm",
              "time_step": "与输入时间步长一致",
              "state_or_flux": "state",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "QC 失败时不产出；不写 NaN。"
            },
            {
              "name": "S3",
              "semantics": "末箱蓄水状态，非负，仅经单一侧孔出流，退水最慢。",
              "units": "mm",
              "time_step": "与输入时间步长一致",
              "state_or_flux": "state",
              "accumulated_or_instantaneous": "instantaneous",
              "missing_value_semantics": "QC 失败时不产出；不写 NaN。"
            }
          ]
        },
        {
          "id": "event_index",
          "description": "event 模式下的场次清单，记录每场的行数、起止时间与预热步数。",
          "required": false,
          "format": "CSV"
        },
        {
          "id": "run_result",
          "description": "符合 HydroTune 运行结果约定的 result.json，含参数、输入与产物 SHA-256、QC 与 provenance。",
          "required": true,
          "format": "JSON"
        }
      ],
      "warmup_period": {
        "required": false,
        "semantics": "由 --warmup-steps 显式声明的前 N 步标记 is_warmup 且不纳入模拟期统计；源码没有 warmup 机制，标记段照常从 t*_is 初值递推。"
      },
      "simulation_period": {
        "required": true,
        "semantics": "扣除预热后的全部时步；模拟期为空即失败，退出码 2。"
      },
      "invariants": [
        "时间轴必须严格递增、等间隔，并与 --timestep-hours 一致。",
        "四箱蓄水必须非负（源码 floor 0 兜底）。",
        "状态与通量必须全部有限，出现 NaN 或 Inf 即失败。",
        "水量平衡残差以 warning 报告：floor 0 截断与负净雨入流使闭合为近似，不作失败判定。",
        "输出只写入 --output-dir，forcing 缺测或参数越界即停止，不静默填充也不静默复用旧结果。",
        "本 Skill 自包含产汇流，输出 Q 即出口流量，不把汇流拆给其它 Skill。"
      ]
    },
