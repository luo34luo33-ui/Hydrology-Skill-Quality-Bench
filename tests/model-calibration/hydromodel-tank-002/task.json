  "id": "hydromodel-tank-002",
  "primary_skill": "hydrological-modeling/run-lumped-tank-model",
  "prompt": "Use forcing.csv and parameters.json exactly as supplied to run hydrological-modeling/run-lumped-tank-model. The forcing deliberately contains a dry spell (hours 40-51: P=0, E0=0.9 mm/h) that turns the net rain negative and drives the tanks into the native numerical-clipping regime; this is a confirmed user decision. Run verbatim with area 640 km2, timestep 1 h, mode continuous, warm-up 12 steps, and write the native outputs (lumped_tank_runoff.csv, result.json) under tank-run/. Numerical clipping must be reported natively in result.json, never hidden or corrected by altering parameters or forcing. Do not 'improve' the configuration to avoid the warning.",
  "required_outputs": [
    "tank-run/lumped_tank_runoff.csv",
    "tank-run/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The parameter set, area, timestep, mode, and warm-up are confirmed by the user and must not be altered.",
    "P and the evaporation column are instantaneous rates in mm/h; discharge outputs are in m3/s.",
    "Do not install software or implement a replacement model."
  ],
  "timeout_seconds": 300,
  "title": "Report numerical clipping caused by negative net rain instead of hiding it"
}
