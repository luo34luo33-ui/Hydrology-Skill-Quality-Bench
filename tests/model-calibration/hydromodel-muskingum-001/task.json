{
  "data_description": "A deterministic hourly Muskingum routing problem with a confirmed route specification and gap-free (or explicitly broken) inflow table.",
  "data_files": [
    "inflow.csv",
    "route_spec.json"
  ],
  "difficulty": "intermediate",
  "domain": "model-calibration",
  "grading": [
    {
      "name": "artifact_schema",
      "required_columns": {
        "routed/result.json": [
          "schema_version",
          "skill",
          "status",
          "message",
          "parameters",
          "inputs",
          "artifacts",
          "checks",
          "warnings",
          "provenance"
        ],
        "routed/route_coefficients.json": [
          "mainstem",
          "tributary"
        ],
        "routed/routed_flow.csv": [
          "time",
          "routed_mainstem",
          "routed_tributary",
          "Q_total"
        ]
      },
      "targets": [
        "routed/routed_flow.csv",
        "routed/route_coefficients.json",
        "routed/result.json"
      ],
      "type": "file_check",
      "weight": 0.1
    },
    {
      "atol": 1e-09,
      "datetime_columns": [
        "time"
      ],
      "name": "routed_flow",
      "reference": "expected/golden_workspace/routed/routed_flow.csv",
      "rtol": 1e-09,
      "target": "routed/routed_flow.csv",
      "type": "table_match",
      "weight": 0.25
    },
    {
      "name": "route_coefficients",
      "reference": "expected/golden_workspace/routed/route_coefficients.json",
      "target": "routed/route_coefficients.json",
      "type": "exact_match",
      "weight": 0.15
    },
    {
      "field": "skill",
      "name": "result_skill",
      "reference": "expected/golden_workspace/routed/result.json",
      "target": "routed/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "status",
      "name": "result_status",
      "reference": "expected/golden_workspace/routed/result.json",
      "target": "routed/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "message",
      "name": "result_message",
      "reference": "expected/golden_workspace/routed/result.json",
      "target": "routed/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "warnings",
      "name": "result_warnings",
      "reference": "expected/golden_workspace/routed/result.json",
      "target": "routed/result.json",
      "type": "exact_match",
      "weight": 0.1
    },
    {
      "field": "checks",
      "name": "result_checks",
      "reference": "expected/golden_workspace/routed/result.json",
      "target": "routed/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "name": "artifact_references",
      "required_keys": [
        "routed_table",
        "route_coefficients"
      ],
      "target": "routed/result.json",
      "type": "artifact_reference_check",
      "weight": 0.2
    }
  ],
  "id": "hydromodel-muskingum-001",
  "primary_skill": "hydrological-modeling/route-muskingum-channel",
  "prompt": "Use inflow.csv and route_spec.json exactly as supplied to run hydrological-modeling/route-muskingum-channel. The inflow table is hourly, gap-free, and both columns are instantaneous discharge in m3/s. The route spec confirms K, X, layout, reaches, and output_level for each route; use --timestep-hours 1, --combine sum, and the default Q_total output column. Write the native outputs (routed_flow.csv, route_coefficients.json, result.json) under routed/. Do not modify the route parameters, clip or repair any computed value, or substitute another routing method.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "routed/routed_flow.csv",
    "routed/route_coefficients.json",
    "routed/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The route specification is confirmed by the user and must not be altered.",
    "All inflow values are instantaneous discharge in m3/s on a regular hourly axis.",
    "Do not install software or implement a replacement routing routine."
  ],
  "timeout_seconds": 300,
  "title": "Route two inflow sources with single and cascaded Muskingum channels"
}
