      "type": "file_absence_check",
      "weight": 0.2
    }
  ],
  "id": "hydromodel-topmodel-003",
  "primary_skill": "hydrological-modeling/run-lumped-topmodel",
  "prompt": "Use terrain_result.json, forcing.csv, and params.json exactly as supplied to run hydrological-modeling/run-lumped-topmodel. The forcing deliberately misses one daily step, leaving a gap in the time axis; run the skill verbatim and only the native result.json under topmodel-run/. Do not fill the gap or alter the forcing; the script must reject the run itself. No process.csv, final_state.json, or model_config.json may remain in topmodel-run/.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "topmodel-run/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The terrain chain and the model configuration are confirmed by the user and must not be altered.",
    "Forcing timestamps carry explicit +08:00 offsets with interval_end semantics.",
    "Do not install software or implement a replacement TOPMODEL."
  ],
  "timeout_seconds": 300,
  "title": "Reject a TOPMODEL run whose forcing time axis has a gap"
}
