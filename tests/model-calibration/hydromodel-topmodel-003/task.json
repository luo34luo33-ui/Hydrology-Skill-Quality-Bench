      "target": "topmodel-run/result.json",
      "type": "exact_match",
      "weight": 0.1
    },
    {
      "field": "status",
      "name": "result_status",
      "reference": "expected/golden_workspace/topmodel-run/result.json",
      "target": "topmodel-run/result.json",
      "type": "exact_match",
      "weight": 0.2
    },
    {
      "field": "message",
      "name": "failure_reason",
      "reference": "expected/golden_workspace/topmodel-run/result.json",
