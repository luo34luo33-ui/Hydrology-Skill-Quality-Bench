    "xaj-sd-run/reach_process.csv",
    "xaj-sd-run/outlet_flow.csv",
    "xaj-sd-run/model_config.json",
    "xaj-sd-run/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The HydroBase chain and the 16-parameter set are confirmed by the user and must not be altered.",
