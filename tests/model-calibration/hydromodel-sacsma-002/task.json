  "id": "hydromodel-sacsma-002",
  "primary_skill": "hydrological-modeling/run-lumped-sacsma-model",
  "prompt": "Use forcing.csv and parameters.json exactly as supplied to run hydrological-modeling/run-lumped-sacsma-model. The confirmed parameter set uses RIVA=0.05, and the forcing deliberately contains a strong-evaporation dry spell (days 40-52: P=0, E0=8 mm/day) that drives the riparian demand into the native numerical-clipping regime. Run verbatim with --pet-column E0, area 640 km2, timestep 24 h, mode continuous, warm-up 12 steps, balance tolerance 4.5. Write the native outputs (lumped_sacsma_runoff.csv, result.json) under sacsma-run/. Numerical clipping must be reported natively in result.json, never hidden or corrected by altering parameters or forcing. Do not 'improve' the configuration to avoid the warning.",
  "required_outputs": [
    "sacsma-run/lumped_sacsma_runoff.csv",
    "sacsma-run/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The parameter set, area, timestep, mode, and warm-up are confirmed by the user and must not be altered.",
    "P and the evaporation column are instantaneous rates in mm/h; discharge outputs are in m3/s.",
    "Do not install software or implement a replacement model."
  ],
  "timeout_seconds": 300,
  "title": "Report the native clipping caused by riparian demand in a dry spell"
}
