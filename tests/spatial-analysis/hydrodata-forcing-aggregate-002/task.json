    },
    {
      "atol": 1e-09,
      "name": "weights_table",
      "reference": "expected/golden_workspace/aggregate-out/weights.csv",
      "rtol": 1e-09,
      "target": "aggregate-out/weights.csv",
      "type": "table_match",
      "weight": 0.1
    },
    {
      "atol": 1e-09,
      "name": "coverage_table",
      "reference": "expected/golden_workspace/aggregate-out/coverage.csv",
      "rtol": 1e-09,
      "target": "aggregate-out/coverage.csv",
      "type": "table_match",
      "weight": 0.1
    },
    {
      "field": "skill",
      "name": "result_skill",
      "reference": "expected/golden_workspace/aggregate-out/result.json",
      "target": "aggregate-out/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "status",
      "name": "result_status",
      "reference": "expected/golden_workspace/aggregate-out/result.json",
      "target": "aggregate-out/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "message",
      "name": "result_message",
      "reference": "expected/golden_workspace/aggregate-out/result.json",
      "target": "aggregate-out/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "warnings",
      "name": "result_warnings",
      "reference": "expected/golden_workspace/aggregate-out/result.json",
      "target": "aggregate-out/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
      "field": "checks",
      "name": "result_checks",
      "reference": "expected/golden_workspace/aggregate-out/result.json",
      "target": "aggregate-out/result.json",
      "type": "exact_match",
      "weight": 0.05
    },
    {
