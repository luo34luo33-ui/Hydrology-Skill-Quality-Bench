      "target": "aggregate-out/result.json",
      "type": "artifact_reference_check",
      "weight": 0.15
    }
  ],
  "id": "hydrodata-forcing-aggregate-002",
  "primary_skill": "spatial-analysis/aggregate-forcing-to-model-units",
  "prompt": "Use build_result.json, topology_qc_result.json, and source_config.json exactly as supplied to run spatial-analysis/aggregate-forcing-to-model-units with --target basin. The P layer comes from a prepare-model-forcing result and the PET layer from a derive-potential-evapotranspiration result (both hash-checked); the confirmed target merges both subbasins into one basin unit. Write the native outputs (basin_forcing.csv, weights.csv, coverage.csv, result.json) under aggregate-out/. Do not modify the upstream artifacts or aggregate with weights of your own.",
  "public_contract": "public_contract.json",
  "required_outputs": [
    "aggregate-out/basin_forcing.csv",
    "aggregate-out/weights.csv",
    "aggregate-out/coverage.csv",
    "aggregate-out/result.json"
  ],
  "secondary_skills": [],
  "setup_notes": [
    "The upstream results and the source config are consumed by native hash checks; they must not be altered.",
    "Station coordinates are confirmed in EPSG:32649 and the Thiessen weights follow from them.",
    "Do not install software or implement a replacement aggregation."
  ],
  "timeout_seconds": 300,
  "title": "Aggregate station forcing to the whole-basin unit"
}
