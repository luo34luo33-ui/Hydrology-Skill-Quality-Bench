{
  "data_description": "A deterministic station-forcing aggregation fixture over a hash-checked two-subbasin HydroBase.",
  "data_files": [
    "build_result.json",
    "topology_qc_result.json",
    "subbasins_clipped.tif",
    "subbasins_table.csv",
    "stations.csv",
    "p_result.json",
    "p_forcing.csv",
    "evap_result.json",
    "evap_forcing.csv",
    "source_config.json"
  ],
  "difficulty": "intermediate",
  "domain": "spatial-analysis",
  "grading": [
    {
      "name": "artifact_schema",
      "required_columns": {
        "aggregate-out/basin_forcing.csv": [
          "time",
          "P",
          "PET"
        ],
        "aggregate-out/coverage.csv": [
          "variable",
          "unit_id",
          "coverage_fraction",
          "covered_area_m2",
          "unit_area_m2"
        ],
        "aggregate-out/result.json": [
          "schema_version",
          "skill",
          "status",
          "message",
          "parameters",
          "inputs",
          "artifacts",
          "checks",
          "warnings",
          "provenance"
        ],
        "aggregate-out/weights.csv": [
          "unit_id",
          "source_id",
          "weight",
          "area_m2",
          "variable"
        ]
      },
      "targets": [
        "aggregate-out/basin_forcing.csv",
        "aggregate-out/weights.csv",
        "aggregate-out/coverage.csv",
        "aggregate-out/result.json"
      ],
      "type": "file_check",
      "weight": 0.1
    },
    {
      "atol": 1e-09,
      "name": "forcing_table",
      "reference": "expected/golden_workspace/aggregate-out/basin_forcing.csv",
